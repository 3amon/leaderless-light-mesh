mainmenu "Thread LED ring"

config THREAD_RING_BUILD_ID
	string "Git-derived build identifier"
	default "unknown"
	help
	  Generated by scripts/version_info.py. Included in remote telemetry and
	  release provenance; do not edit it in prj.conf.

config THREAD_RING_FORCE_ROLLBACK_TEST
	bool "Build an image that deliberately remains unconfirmed"
	default n
	help
	  Test-only fault injection. An unconfirmed image suppresses its normal
	  infrastructure-gated confirmation and reboots after eight seconds so
	  MCUboot must revert it. Never enable this in a release image.

config THREAD_RING_FORCE_NO_INFRA_TEST
	bool "Hide infrastructure from the OTA confirmation policy"
	default n
	help
	  Test-only fault injection. The device can attach and remain reachable,
	  but the normal confirmation policy is fed infrastructure_visible=false.
	  The shortened unconfirmed-image deadline then proves MCUboot rollback.
	  Never enable this in a release image.

config THREAD_RING_ESCAPE_HIL_BOOT_HANG
	bool "Build an image that hangs immediately after arming the watchdog"
	default n
	help
	  Test-only fault injection for the boot-recovery ladder bench gate
	  (docs/boot-recovery-ladder.md). The image spins forever right after
	  the early watchdog arm — the exact class of wedge drifting-owl-spark
	  died in — so each boot ends in a watchdog reset and MCUboot's escape
	  ladder must self-present the board as a UF2 drive (USB powered) or
	  park it in System OFF (battery) within ESCAPE_LADDER_MAX_ATTEMPTS
	  boots. Never enable this in a release image.

config THREAD_RING_HIL_FAULT_INJECTION
	bool "Enable physical-USB-only HIL fault injection"
	default n
	depends on SHELL
	help
	  Adds bounded application shell commands used by hardware-in-loop tests.
	  These commands are reachable only through the USB console, automatically
	  restore normal operation, and are compiled out of fleet images.

config THREAD_RING_CONTROL_PROVISIONING
	bool "Enable physical-USB control-key provisioning"
	default n
	depends on SHELL
	help
	  Adds a USB shell command that writes a per-device control key into the
	  settings partition. Enable only in provisioning images; fleet images
	  consume the key but contain no remote or shell key-management command.

source "Kconfig.zephyr"
